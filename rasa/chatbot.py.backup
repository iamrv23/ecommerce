    def get_response(self, message):

        # Enhanced intent mapping with comprehensive keywords
        intent_mapping = {
            "create_customer": [
                "create", "customer", "account", "register", "new", "add", "client",
                "user", "profile", "signup", "registration", "onboard", "setup",
                "record", "entry", "login", "database", "information", "details"
            ],
            "process_order": [
                "order", "place", "process", "purchase", "submit", "create", "handle",
                "fulfill", "transaction", "sale", "sales", "execute", "manage",
 "request", "placement", "system", "now", "new"
            ],
            "check_inventory": [
                "inventory", "stock", "check", "available", "status", "levels",
                "what's", "have", "product", "warehouse", "lookup", "information",
                "details", "item", "quantity", "count", "availability", "report"
            ],
            "assign_license": [
                "license", "assign", "key", "activation", "allocation", "give",
                "distribution", "software", "product", "management", "allocate",
                "provisioning", "access", "permission", "grant", "deployment",
                "setup", "provide"
            ],
            "generate_report": [
                "report", "generate", "show", "analytics", "data", "sales", "business",
                "performance", "summary", "revenue", "customer", "monthly", "weekly",
                "daily", "financial", "transaction", "product", "dashboard", "creation"
            ],
            "automate_workflow": [
                "automate", "workflow", "process", "task", "business", "optimization",
                "streamline", "efficiency", "operations", "improvement", "procedure",
                "routine", "management", "system", "tools", "enhancement", "daily"
            ]
        }

        detected_intent = None
        max_confidence = 0.0

        message_lower = message.lower()
        message_words = set(message_lower.split())

        for intent, keywords in intent_mapping.items():
            # Count matching keywords
            matches = sum(1 for keyword in keywords if keyword in message_lower)
            keyword_set = set(keywords)
            word_matches = len(message_words.intersection(keyword_set))

            # Calculate confidence based on multiple factors
            total_matches = matches + word_matches
            keyword_coverage = total_matches / len(keywords) if keywords else 0
            word_coverage = word_matches / len(message_words) if message_words else 0

            # Weighted confidence score
            confidence = (keyword_coverage * 0.6) + (word_coverage * 0.4)

            # Boost confidence for exact matches and multiple keywords
            if matches >= 2:
                confidence += 0.1
            if word_matches >= 2:
                confidence += 0.1

            # Cap at 0.95 for keyword-based detection
            confidence = min(confidence, 0.95)

            if confidence > max_confidence and confidence >= 0.3:  # Minimum threshold
                max_confidence = confidence
                detected_intent = intent

        # If no intent detected with sufficient confidence, try fallback patterns
        if not detected_intent:
            # Check for question patterns that might indicate specific intents
            if any(word in message_lower for word in ["how many", "how much", "what's left", "available stock"]):
                detected_intent = "check_inventory"
                max_confidence = 0.7
            elif any(word in message_lower for word in ["buy", "purchase", "order", "get"]):
                detected_intent = "process_order"
                max_confidence = 0.7
            elif any(word in message_lower for word in ["report", "analytics", "data", "statistics"]):
                detected_intent = "generate_report"
                max_confidence = 0.7

        return {
            'intent': detected_intent,
            'confidence': round(max_confidence, 2),
            'response': str(response),
            'text': message
        }

def main():
    if len(sys.argv) < 2:
        print(json.dumps({'error': 'No message provided'}))
        sys.exit(1)

    message = sys.argv[1]
    sender = sys.argv[2] if len(sys.argv) > 2 else None

    try:
        # Suppress all output except our final JSON
        old_stdout = sys.stdout
        old_stderr = sys.stderr
        sys.stdout = open(os.devnull, 'w')
        sys.stderr = open(os.devnull, 'w')
        
        chatbot = EcommerceChatbot()
        result = chatbot.get_response(message)
        
        # Restore stdout and print result
        sys.stdout = old_stdout
        sys.stderr = old_stderr
        print(json.dumps(result))
    except Exception as e:
        # Restore stdout/stderr and print error
        sys.stdout = old_stdout
        sys.stderr = old_stderr
        print(json.dumps({
            'error': str(e),
            'intent': None,
            'confidence': 0.0,
            'response': 'Sorry, I encountered an error processing your request.',
            'text': message
        }))

if __name__ == '__main__':
    main()